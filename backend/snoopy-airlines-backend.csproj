<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>snoopy_airlines_backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="db\migrator\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Emails/**" />
  </ItemGroup>

  <ItemGroup>
  <Content Include="..\frontend\src\assets\logoSA.png">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <Link>frontend\src\assets\logoSA.png</Link>
  </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
